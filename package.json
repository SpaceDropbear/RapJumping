{
  "name": "rapjumping-astro",
  "type": "module",
  "version": "1.0.0",
  "scripts": {
    "dev": "node scripts/clear-content-cache.mjs && node scripts/gen-image-variants.mjs && astro dev",
    "build": "node scripts/clear-content-cache.mjs && node scripts/gen-image-variants.mjs && astro build && node scripts/verify-affiliate-links.mjs",
    "preview": "npm run build && wrangler dev",
    "astro": "astro",
    "generate-types": "wrangler types",
    "verify:affiliate": "node scripts/verify-affiliate-links.mjs",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^13.7.0",
    "@astrojs/mdx": "^6.0.1",
    "@astrojs/rss": "^4.0.18",
    "@astrojs/sitemap": "^3.7.3",
    "@fontsource/inter": "^5.2.8",
    "@fontsource/space-grotesk": "^5.2.10",
    "astro": "^6.4.3"
  },
  "devDependencies": {
    "wrangler": "^4.97.0",
    "sharp": "^0.34.0"
  },
  "overrides": {
    "vite": "^7"
  }
}
