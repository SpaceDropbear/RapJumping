---
const nav = [
  { href: '/', label: 'Home' },
  { href: '/about/', label: 'About' },
  { href: '/abseiling-in-australia-the-complete-guide/', label: 'Abseiling' },
  { href: '/tag/equipment/', label: 'Gear' },
  { href: '/blog/', label: 'All articles' },
];
---
<header class="site-header">
  <div class="container">
    <a class="brand" href="/">
      <span class="mark">RJ</span>
      <span>Rap Jumping</span>
    </a>
    <div class="header-right">
      <nav class="nav">
        {nav.map((n) => <a href={n.href}>{n.label}</a>)}
      </nav>
      <button class="theme-toggle" type="button" aria-label="Switch between light and dark mode" title="Toggle theme">
        <svg class="i-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></svg>
        <svg class="i-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
      </button>
    </div>
  </div>
</header>
<script>
  const btn = document.querySelector('.theme-toggle');
  btn?.addEventListener('click', () => {
    const d = document.documentElement;
    const current = d.dataset.theme || (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
    const next = current === 'dark' ? 'light' : 'dark';
    d.dataset.theme = next;
    try {
      localStorage.setItem('theme', next);
    } catch (e) {}
    const m = document.querySelector('meta[name="theme-color"]');
    if (m) m.setAttribute('content', next === 'dark' ? '#b8343f' : '#a12e38');
  });
</script>
