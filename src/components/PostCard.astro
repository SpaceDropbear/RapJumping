---
import SmartImage from './SmartImage.astro';
import { formatDate } from '../utils';
const { post, index = 0 } = Astro.props;
const { title, heroImage, tags = [], pubDate, readingTime } = post.data;
const kicker = tags[0];
const url = `/${post.id.replace(/\.md$/, '')}/`;
---
<article class="card reveal" style={`--i:${index}`}>
  <a href={url}>
    <div class="thumb">
      {/* Decorative: the <h3> below already labels this link, so alt text would make a
          screen reader announce the title twice. The featured grid sits below the hero,
          so lazy loading keeps these off the LCP critical path. */}
      {heroImage && (
        <SmartImage src={heroImage} alt="" widths={[280, 560]} sizes="(max-width: 700px) 100vw, 360px" loading="lazy" />
      )}
    </div>
    <div class="body">
      {kicker && <span class="kicker">{kicker}</span>}
      <h3>{title}</h3>
      <div class="meta">{formatDate(pubDate)}{readingTime ? ` · ${readingTime} min read` : ''}</div>
    </div>
  </a>
</article>
