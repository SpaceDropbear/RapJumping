---
import { Image } from 'astro:assets';
import { formatDate } from '../utils';
const { post } = Astro.props;
const { title, heroImage, tags = [], pubDate, readingTime } = post.data;
const kicker = tags[0];
const url = `/${post.id.replace(/\.md$/, '')}/`;
---
<article class="card">
  <a href={url}>
    <div class="thumb">
      {heroImage && <Image src={heroImage} alt={title} loading="eager" width={280} height={158} />}
    </div>
    <div class="body">
      {kicker && <span class="kicker">{kicker}</span>}
      <h3>{title}</h3>
      <div class="meta">{formatDate(pubDate)}{readingTime ? ` · ${readingTime} min read` : ''}</div>
    </div>
  </a>
</article>
