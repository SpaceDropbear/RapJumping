---
import { getCollection, render } from 'astro:content';
import SmartImage from '../components/SmartImage.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import PostRow from '../components/PostRow.astro';
import { formatDate, tagSlug } from '../utils';

export async function getStaticPaths() {
  const posts = (await getCollection('blog')).filter((p) => !p.data.draft);
  const pages = await getCollection('pages');
  const postPaths = posts.map((entry) => ({
    params: { slug: entry.id },
    props: { entry, kind: 'post' },
  }));
  const pagePaths = pages.map((entry) => ({
    params: { slug: entry.id },
    props: { entry, kind: 'page' },
  }));
  return [...postPaths, ...pagePaths];
}

const { entry, kind } = Astro.props;
const { Content, remarkPluginFrontmatter } = await render(entry);
const d = entry.data;
const isPost = kind === 'post';
// Set at build time by rehypeAffiliateLinks the moment a link on this page is monetised,
// so the disclosure can never drift from the links (ACCC: disclose on the page it happens).
const hasAffiliateLinks = remarkPluginFrontmatter?.hasAffiliateLinks === true;

// Freshness is a trust signal on safety content, but only when it is real: show the
// updated date solely when it is genuinely later than publication.
const showUpdated = isPost && d.updatedDate && d.updatedDate.valueOf() > d.pubDate.valueOf();

const breadcrumbs = isPost
  ? [{ name: 'Home', path: '/' }, { name: 'Blog', path: '/blog/' }, { name: d.title, path: `/${entry.id}/` }]
  : [{ name: 'Home', path: '/' }, { name: d.title, path: `/${entry.id}/` }];

const jsonLd: Record<string, unknown>[] = [];
if (isPost) {
  if (d.faq?.length) {
    jsonLd.push({
      '@type': 'FAQPage',
      mainEntity: d.faq.map((f) => ({
        '@type': 'Question',
        name: f.question,
        acceptedAnswer: { '@type': 'Answer', text: f.answer },
      })),
    });
  }
  if (d.howto) {
    jsonLd.push({
      '@type': 'HowTo',
      name: d.howto.name,
      step: d.howto.steps.map((s, i) => ({
        '@type': 'HowToStep',
        position: i + 1,
        name: s.name,
        text: s.text,
      })),
    });
  }
}

// Related guides: the 3 posts that share the most tags with this one.
let related: any[] = [];
if (isPost) {
  const tset = new Set(d.tags || []);
  related = (await getCollection('blog'))
    .filter((p) => !p.data.draft && p.id !== entry.id)
    .map((p) => ({ p, score: (p.data.tags || []).filter((t) => tset.has(t)).length }))
    .filter((x) => x.score > 0)
    .sort((a, b) => b.score - a.score || (+b.p.data.pubDate - +a.p.data.pubDate))
    .slice(0, 3)
    .map((x) => x.p);
}
---
<BaseLayout
  title={isPost ? d.title : `${d.title} | Rap Jumping`}
  description={d.description}
  image={d.heroImage || undefined}
  type={isPost ? 'article' : 'website'}
  headline={d.title}
  pubDate={isPost ? d.pubDate : undefined}
  updatedDate={isPost ? d.updatedDate : undefined}
  breadcrumbs={breadcrumbs}
  jsonLd={jsonLd}
>
  <article class="wrap-narrow">
    <header class="article-head" style="margin-top: 36px;">
      {kind === 'post' && d.tags?.[0] && (
        <a class="pill" style="text-decoration:none;" href={`/tag/${tagSlug(d.tags[0])}/`}>{d.tags[0]}</a>
      )}
      <h1>{d.title}</h1>
      {kind === 'post' && (
        <div class="article-meta">
          <span>By <a href="/about/" style="color:inherit;">Derek Whittingham</a></span>
          <span>· {formatDate(d.pubDate)}</span>
          {showUpdated && <span>· Updated {formatDate(d.updatedDate)}</span>}
          {d.readingTime && <span>· {d.readingTime} min read</span>}
        </div>
      )}
    </header>

    {d.heroImage && (
      <div class="article-hero">
        <SmartImage
          src={d.heroImage}
          alt={d.heroAlt ?? d.title}
          widths={[380, 760, 1140]}
          sizes="(max-width: 800px) 100vw, 760px"
          loading="eager"
          fetchpriority="high"
        />
      </div>
    )}

    {hasAffiliateLinks && (
      <aside class="affiliate-note">
        If you buy or book through a link on this page, Rap Jumping earns a small commission
        from the retailer or operator. You pay the same price. Recommendations are independent.
      </aside>
    )}

    <div class="prose">
      <Content />
    </div>

    {isPost && (
      <aside class="author-note">
        <p><strong>Written by Derek Whittingham.</strong> Rap Jumping is an independent Australian guide to abseiling, rappelling and rap jumping. Everything here is general information, not a substitute for hands-on training. Always learn and practise under a qualified instructor. <a href="/about/">About us</a>.</p>
      </aside>
    )}

    {!isPost && d.showTrust && (
      <aside class="trust-note">
        <div class="trust-mark" aria-hidden="true">RJ</div>
        <div>
          <p class="trust-name">Derek Whittingham</p>
          {d.trustNote && <p class="trust-body">{d.trustNote}</p>}
          {d.updatedDate && <p class="trust-updated">This page was last reviewed on {formatDate(d.updatedDate)}.</p>}
        </div>
      </aside>
    )}

    {!isPost && d.showTrust && (
      <div class="page-cta">
        <a class="btn btn-primary" href="/blog/">Explore the guides</a>
      </div>
    )}

    {isPost && related.length > 0 && (
      <section class="related">
        <div class="section-head"><h2>Related guides</h2></div>
        <div>
          {related.map((p, i) => <PostRow post={p} index={i} />)}
        </div>
      </section>
    )}

    {kind === 'post' && d.tags?.length > 0 && (
      <div class="tagrow" style="margin: 40px 0 0;">
        {d.tags.map((t) => <a class="tag" href={`/tag/${tagSlug(t)}/`}>{t}</a>)}
      </div>
    )}
  </article>
</BaseLayout>
