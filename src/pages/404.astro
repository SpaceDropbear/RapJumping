---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Page not found | Rap Jumping">
  <div class="wrap-narrow" style="text-align:center; padding: 80px 20px;">
    <span class="pill">404</span>
    <h1 class="page-title">We couldn't find that page</h1>
    <p class="page-sub">It may have moved. Try the latest articles instead.</p>
    <p style="margin-top: 20px;"><a class="tag" href="/">Back home</a> <a class="tag" href="/blog/">All articles</a></p>
  </div>
</BaseLayout>
