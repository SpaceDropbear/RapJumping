---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import PostRow from '../components/PostRow.astro';
import { sortByDate, tagSlug } from '../utils';

const posts = (await getCollection('blog')).filter((p) => !p.data.draft).sort(sortByDate);
const featured = posts.filter((p) => p.data.featured).slice(0, 3);
const featuredIds = new Set(featured.map((p) => p.id));
const latest = posts.filter((p) => !featuredIds.has(p.id)).slice(0, 8);

const tagCounts = new Map();
for (const p of posts) for (const t of p.data.tags) tagCounts.set(t, (tagCounts.get(t) || 0) + 1);
const topTags = [...tagCounts.entries()].sort((a, b) => b[1] - a[1]).slice(0, 12).map(([t]) => t);

const heroImage = '/images/2025/07/rapjumping-extreme-urban-adventure.JPG';
---
<BaseLayout>
  <div class="container">
    <section class="hero">
      <Image src={heroImage} alt="Abseiling in Australia" width={1100} height={340} loading="eager" />
      <div class="scrim"></div>
      <div class="hero-inner">
        <span class="pill">Australia</span>
        <h1>Australia's best abseiling spots, gear &amp; expert guides</h1>
        <p>Discover top-rated climbing gear and get expert adventure guides, tips, and trusted picks.</p>
      </div>
    </section>

    {featured.length > 0 && (
      <>
        <div class="section-head"><h2>Featured</h2><a href="/blog/">View all</a></div>
        <div class="grid">
          {featured.map((post) => <PostCard post={post} />)}
        </div>
      </>
    )}

    <div class="section-head"><h2>Latest</h2><a href="/blog/">All articles</a></div>
    <div>
      {latest.map((post, i) => <PostRow post={post} eager={i === 0} />)}
    </div>

    <div class="section-head"><h2>Explore topics</h2></div>
    <div class="tagrow" style="margin-bottom: 20px;">
      {topTags.map((t) => <a class="tag" href={`/tag/${tagSlug(t)}/`}>{t}</a>)}
    </div>
  </div>
</BaseLayout>
